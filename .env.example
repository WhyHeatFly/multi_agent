APP_ENV=development
APP_NAME=文化 IP 设计师 Agent
API_PREFIX=/v1
DATABASE_URL=postgresql+psycopg://cultural_ip:cultural_ip_password@postgres:5432/cultural_ip
POSTGRES_DB=cultural_ip
POSTGRES_USER=cultural_ip
POSTGRES_PASSWORD=cultural_ip_password

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60

PUBLIC_DOMAIN=localhost
HTTPS_CERT_PATH=/etc/nginx/certs/fullchain.pem
HTTPS_KEY_PATH=/etc/nginx/certs/privkey.pem

